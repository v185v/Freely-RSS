{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "include": [
      "apps/**/*",
      "packages/**/*",
      "package.json",
      "pnpm-workspace.yaml",
      "lefthook.yml"
    ],
    "ignore": ["apps/**/dist/**/*", "apps/**/src-tauri/gen/**/*", "apps/**/src-tauri/target/**/*"],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
