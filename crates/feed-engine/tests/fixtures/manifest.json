{
  "version": 1,
  "requiredScenarios": [
    "rss",
    "atom",
    "json-feed",
    "rich-media",
    "duplicate-articles",
    "missing-fields",
    "longform",
    "multilingual",
    "html-single-feed",
    "html-multiple-feeds",
    "html-no-feed",
    "malformed-xml",
    "unsupported-feed-root",
    "unsupported-json-version",
    "invalid-json"
  ],
  "fixtures": [
    {
      "id": "rss-rich-media",
      "format": "rss",
      "path": "rss/rss-2-rich-media.xml",
      "expectedOutcome": "parsed-feed",
      "articleCount": 2,
      "scenarios": ["rss", "rich-media"],
      "markers": [
        "<!-- freelyrss-fixture-scenario: rich-media -->",
        "https://media.example.com/podcast/ep1.mp3",
        "https://media.example.com/images/launch-diagram.png"
      ]
    },
    {
      "id": "rss-duplicates-and-missing-fields",
      "format": "rss",
      "path": "rss/rss-2-duplicates-and-missing-fields.xml",
      "expectedOutcome": "parsed-feed",
      "articleCount": 3,
      "scenarios": ["rss", "duplicate-articles", "missing-fields"],
      "markers": [
        "<!-- freelyrss-fixture-scenario: duplicate-articles -->",
        "<!-- freelyrss-fixture-scenario: missing-fields -->",
        "https://example.com/articles/duplicate-story"
      ]
    },
    {
      "id": "rss-091-legacy",
      "format": "rss",
      "path": "rss/rss-0.91-legacy.xml",
      "expectedOutcome": "parsed-feed",
      "articleCount": 1,
      "scenarios": ["rss", "legacy-rss-0.91"],
      "markers": [
        "<!-- freelyrss-fixture-scenario: legacy-rss-0.91 -->",
        "Legacy Netscape-style channel"
      ]
    },
    {
      "id": "atom-longform-multilingual",
      "format": "atom",
      "path": "atom/atom-longform-multilingual.xml",
      "expectedOutcome": "parsed-feed",
      "articleCount": 2,
      "scenarios": ["atom", "longform", "multilingual"],
      "markers": [
        "<!-- freelyrss-fixture-scenario: longform -->",
        "<!-- freelyrss-fixture-scenario: multilingual -->",
        "离线优先阅读器",
        "多言語の長文検証"
      ]
    },
    {
      "id": "json-feed-podcast",
      "format": "json-feed",
      "path": "json-feed/json-feed-podcast.json",
      "expectedOutcome": "parsed-feed",
      "articleCount": 2,
      "scenarios": ["json-feed", "rich-media"],
      "markers": [
        "\"_fixtureScenarios\": [\"json-feed\", \"rich-media\"]",
        "https://media.example.com/audio/dispatch-1.mp3",
        "https://media.example.com/images/dispatch-cover.jpg"
      ]
    },
    {
      "id": "html-single-feed",
      "format": "html",
      "path": "html/html-single-feed.html",
      "expectedOutcome": "feed-discovery",
      "articleCount": 1,
      "scenarios": ["html-single-feed"],
      "markers": [
        "freelyrss-fixture-scenario: html-single-feed",
        "FreelyRSS Journal RSS",
        "/feeds/journal.xml"
      ]
    },
    {
      "id": "html-multiple-feeds",
      "format": "html",
      "path": "html/html-multiple-feeds.html",
      "expectedOutcome": "feed-discovery",
      "articleCount": 4,
      "scenarios": ["html-multiple-feeds"],
      "markers": [
        "freelyrss-fixture-scenario: html-multiple-feeds",
        "Labs RSS",
        "Labs Atom",
        "https://feeds.example.net/labs/feed.json"
      ]
    },
    {
      "id": "html-no-feed",
      "format": "html",
      "path": "html/html-no-feed.html",
      "expectedOutcome": "feed-discovery",
      "articleCount": 0,
      "scenarios": ["html-no-feed"],
      "markers": [
        "freelyrss-fixture-scenario: html-no-feed",
        "FreelyRSS About",
        "Plain HTML page fixture without any discoverable feed links."
      ]
    },
    {
      "id": "malformed-rss",
      "format": "rss",
      "path": "invalid/malformed-rss.xml",
      "expectedOutcome": "parse-error",
      "expectedErrorKind": "parse",
      "expectedMessageFragment": "feed XML could not be parsed",
      "articleCount": 1,
      "scenarios": ["rss", "malformed-xml"],
      "markers": [
        "freelyrss-fixture-scenario: malformed-xml",
        "Missing closing rss element on purpose."
      ]
    },
    {
      "id": "unsupported-opml-root",
      "format": "xml",
      "path": "invalid/unsupported-opml-root.xml",
      "expectedOutcome": "parse-error",
      "expectedErrorKind": "parse",
      "expectedMessageFragment": "unsupported feed root element: opml",
      "articleCount": 0,
      "scenarios": ["unsupported-feed-root"],
      "markers": [
        "freelyrss-fixture-scenario: unsupported-feed-root",
        "<opml version=\"2.0\">"
      ]
    },
    {
      "id": "unsupported-json-feed-version",
      "format": "json",
      "path": "invalid/unsupported-json-feed-version.json",
      "expectedOutcome": "parse-error",
      "expectedErrorKind": "parse",
      "expectedMessageFragment": "unsupported JSON Feed version",
      "articleCount": 0,
      "scenarios": ["json-feed", "unsupported-json-version"],
      "markers": [
        "\"_fixtureScenarios\": [\"unsupported-json-version\"]",
        "\"version\": \"https://jsonfeed.org/version/2\""
      ]
    },
    {
      "id": "invalid-json-feed",
      "format": "json",
      "path": "invalid/invalid-json-feed.json",
      "expectedOutcome": "parse-error",
      "expectedErrorKind": "parse",
      "expectedMessageFragment": "feed JSON could not be parsed",
      "articleCount": 0,
      "scenarios": ["json-feed", "invalid-json"],
      "markers": [
        "freelyrss-fixture-scenario: invalid-json",
        "Invalid JSON Feed Syntax"
      ]
    }
  ]
}
